# =========================
# Airflow Admin User
# =========================
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=CHANGE_ME
AIRFLOW_UID=50000

# =========================
# Snowflake Connection (URL-ENCODED!)
# =========================
# Format: snowflake://USER:PASSWORD@?account=ACCOUNT&database=DB&schema=SCHEMA&warehouse=WH
AIRFLOW_CONN_SNOWFLAKE_DEFAULT=snowflake://YOUR_USER:YOUR_PASSWORD@?account=YOUR_ACCOUNT&database=PE_ORGAIR&schema=PUBLIC&warehouse=COMPUTE_WH

# =========================
# AWS Connection (URL-ENCODED!)
# =========================
# Format: aws://ACCESS_KEY:SECRET_KEY@?region_name=REGION
AIRFLOW_CONN_AWS_DEFAULT=aws://YOUR_ACCESS_KEY:YOUR_SECRET_KEY@?region_name=us-east-1

# =========================
# Airflow Variables
# =========================
AIRFLOW_VAR_S3_BUCKET=your-s3-bucket-name